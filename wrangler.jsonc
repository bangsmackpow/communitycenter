{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "southwest-iowa-community",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "southwest-iowa-db",
      "database_id": "southwest-iowa-local-db-placeholder",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "southwest-iowa-assets"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173",
    "BETTER_AUTH_SECRET": "southwest_iowa_dev_secret_key_edge_32chars_min"
  }
}
