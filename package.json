{
  "name": "southwest-iowa-community",
  "version": "1.0.0",
  "description": "Southwest Iowa Community Platform - Rentals, Local Contractors & Events (Edge Cloudflare)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply southwest-iowa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply southwest-iowa-db --remote --account-id=0e528c886015cce349076fb7db222a88",
    "pages:dev": "wrangler pages dev dist"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "better-auth": "^1.2.9",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^3.111.0"
  }
}
